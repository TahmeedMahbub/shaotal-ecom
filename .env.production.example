# PRODUCTION TEMPLATE — no real values. Copy to .env ON THE SERVER ONLY and fill in the <...> placeholders there.
# Never commit the filled-in file. Check it with: php artisan storefront:deploy-check
# See STOREFRONT_DEPLOYMENT_CHECKLIST.md.

APP_NAME=Shaotal
APP_ENV=production
APP_KEY=                              # php artisan key:generate --show (once; keep it stable)
APP_DEBUG=false
APP_URL=https://<public-domain>       # no trailing slash; used for canonical URLs, sitemap, robots.txt
APP_TIMEZONE=UTC                      # storage standard; do not change

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=hishabiz_ecom
DB_USERNAME=<db-user>                 # least privilege: SELECT/INSERT/UPDATE/DELETE on the storefront tables
DB_PASSWORD=<db-password>
DB_TIMEZONE=+00:00

SESSION_DRIVER=file                   # one server; use redis when running several app servers
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# SESSION_DOMAIN=                     # leave unset unless sessions must span subdomains

CACHE_STORE=file                      # one server; redis when several (rate limits, checkout lock, catalog cache)
QUEUE_CONNECTION=sync                 # the storefront queues nothing

# Behind a load balancer/CDN that terminates TLS: its addresses (comma-separated) or * if the app is only reachable
# through it. Leave empty for Apache/Nginx serving TLS on the same machine.
TRUSTED_PROXIES=

# Time zone for dates shown to customers (storage stays UTC). Owner decision: Australia/Sydney, which is also the
# default when this is unset. Shown with AEST/AEDT.
STOREFRONT_DISPLAY_TIMEZONE=Australia/Sydney

# Approved policy pages, contact details, returns (on/off, window, reasons), pickup, shipping fees, payment methods,
# deposit/discount and delivery wording are NOT env settings any more: the admin app manages them in the config_data
# table (docs/config-data.md). Every key must exist there before deploy; storefront:deploy-check lists missing ones.
# Stripe card payments still also need STRIPE_ENABLED and the Stripe keys below.

MAIL_MAILER=smtp                      # password-reset codes need real mail
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS=<from-address>
MAIL_FROM_NAME="${APP_NAME}"

# Google sign-in (leave empty to hide the button). Callback: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe card payments: live keys + the live webhook endpoint's signing secret (docs/stripe-deployment.md).
# Keep STRIPE_ENABLED=false until the owner approves going live.
STRIPE_ENABLED=false
STRIPE_MODE=live
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=aud
