APP_NAME=Shaotal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Verification / password-reset emails (App\Support\AuthMail): deferred = sent right after the response, no worker.
# database|redis|failover = real queue: needs the jobs table (sql/proposed_changes.sql) and `php artisan queue:work`.
AUTH_MAIL_QUEUE_CONNECTION=deferred

# Mail (config/mail.php). Brevo SMTP relay: MAIL_MAILER=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587
# (STARTTLS; use MAIL_SCHEME=smtps with port 465 for implicit TLS), MAIL_USERNAME/MAIL_PASSWORD = Brevo SMTP login + SMTP key.
# MAIL_FROM_ADDRESS must be a sender or domain verified in Brevo. The sender name follows APP_NAME unless MAIL_FROM_NAME is set.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google login (leave empty to hide the button). Callback defaults to {APP_URL}/auth/google/callback; set
# GOOGLE_REDIRECT_URI only when the site is reached on another host (e.g. local https://shaotal.test). Every value
# used must be listed under Authorized redirect URIs of the OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://shaotal.test/auth/google/callback

# Stripe card payments (Stripe Checkout). See docs/stripe-deployment.md. Keys only here, never in code or Git.
# STRIPE_MODE must match the keys: test = pk_test_/sk_test_ (Sandbox), live = pk_live_/sk_live_. On a mismatch, or with
# any key missing, the card option stays hidden and checkout offers COD only.
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_KEY=
STRIPE_SECRET=
# Signing secret of the webhook endpoint {APP_URL}/webhooks/stripe (whsec_…)
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=aud
# STRIPE_SESSION_MINUTES=60
